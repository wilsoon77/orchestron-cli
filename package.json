{
  "name": "orchestron",
  "version": "2.0.0",
  "description": "Interactive CLI for orchestrating multi-agent teams, quality gates, and living context in AI-assisted codebases",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "orchestron": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --shims",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "npx vitest run",
    "test:watch": "npx vitest"
  },
  "keywords": [
    "ai",
    "agents",
    "orchestrator",
    "antigravity",
    "claude-code",
    "cursor",
    "agents-md"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "boxen": "^9.0.0",
    "commander": "^15.0.0",
    "gradient-string": "^3.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/gradient-string": "^1.1.6",
    "@types/node": "^26.6.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
